# Only needed to run `npm run embed`, which recomputes map positions from real
# embeddings. The site builds and runs fine without these — positions fall back
# to a deterministic per-cluster layout.
#
# Create a token at: Cloudflare dashboard > AI > Workers AI > Use REST API
# The token needs the "Workers AI" read permission and nothing else.

CF_ACCOUNT_ID=
CF_API_TOKEN=
