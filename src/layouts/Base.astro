---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Marks a page whose map view owns the full viewport. Only takes effect at
   * sizes where the map is actually shown — see "surface switching" in
   * global.css. Below that the same page renders the index, which must scroll.
   */
  fixed?: boolean;
}

const { title, description = 'Learn, execute, report.', fixed = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body class={fixed ? 'is-fixed' : ''}>
    <slot />
  </body>
</html>
